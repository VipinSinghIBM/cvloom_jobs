# ========================================================
# Apache Configuration for Subdomain or Subfolder Deployment
# Sarkari Global / PurposeHire Recruitment Portal
# ========================================================

RewriteEngine On

# 1. Enable Authorization Header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 2. Allow direct access to api.php, database.sql, and existing files/directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Route all other frontend requests to index.html (works in root, subdomain, or /jobs/ subfolder!)
RewriteRule ^ index.html [L]

# 4. Gzip / Deflate Compression for high speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
